# Firebase service account key — paste the full JSON as a single-line string
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Firestore user ID to scope all reads/writes to (find in Firebase Auth console)
USER_ID=your-firebase-user-id

# API key for authenticating requests (set a long random string)
API_KEY=your-secret-api-key

# Port to run on (default: 3001)
PORT=3001
